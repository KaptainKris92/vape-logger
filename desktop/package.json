{
  "name": "vaper-taper-desktop",
  "productName": "Vaper Taper",
  "version": "1.0.0",
  "description": "Vaper Taper for Windows: the app in app/, in the tray, connected all the time.",
  "private": true,
  "main": "main.js",
  "author": "Kris Adamatzky",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "uk.co.vapertaper.desktop",
    "productName": "Vaper Taper",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "web",
        "filter": [
          "**/*",
          "!tests/**",
          "!README.md"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
